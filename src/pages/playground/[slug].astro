---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PixelSprite from "../../components/PixelSprite.astro";
import { bubble } from "../../data/sprites";
import { games } from "../../data/games";

export function getStaticPaths() {
  return games.map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
const others = games.filter((g) => g.slug !== game.slug);
---

<Layout title={game.title} description={game.copy}>
  {/* ヒーローはゲーム自身の配色で塗る。サイトの中に小さな別世界を置く感覚 */}
  <section
    class="scanlines relative overflow-hidden px-4 pt-36 pb-24 sm:px-6"
    style={`background:${game.palette.bg};`}
  >
    <div class="relative mx-auto max-w-5xl">
      <a
        href="/playground"
        class="font-arcade text-[10px] opacity-70 hover:opacity-100"
        style={`color:${game.palette.fg};`}
      >
        ← BACK TO PLAYGROUND
      </a>

      <p
        class="mt-10 font-arcade text-[10px] tracking-widest opacity-60"
        style={`color:${game.palette.fg};`}
      >
        {game.year} / {game.status}
      </p>

      <h1
        class="mt-5 font-arcade text-[clamp(1.8rem,7vw,4.5rem)] leading-tight"
        style={`color:${game.palette.fg}; text-shadow: 5px 5px 0 ${game.palette.accent};`}
      >
        {game.titleEn}
      </h1>

      <p class="mt-7 font-pixel text-2xl sm:text-3xl" style={`color:${game.palette.fg};`}>
        {game.copy}
      </p>

      <a
        href={game.url}
        target="_blank"
        rel="noopener noreferrer"
        class="pixel-button mt-11"
        style={`background:${game.palette.accent}; color:${game.palette.bg}; font-size:1.15rem; padding:1.1rem 2rem;`}
      >
        ▶ あそぶ（別タブでひらきます）
      </a>

      <div
        class="scanlines mt-16 overflow-hidden border-[3px]"
        style={`border-color:${game.palette.fg}; box-shadow: 9px 9px 0 0 ${game.palette.accent};`}
      >
        <Image
          src={game.shot}
          alt={`${game.title} のプレイ画面`}
          widths={[600, 1000, 1400]}
          sizes="(max-width: 1024px) 100vw, 900px"
          class="w-full"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="bg-abyss px-4 py-20 sm:px-6">
    <div class="mx-auto grid max-w-5xl gap-14 md:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="font-pixel text-3xl text-foam">{game.title} について</h2>
        <p class="mt-6 text-lg text-mist">{game.description}</p>

        <h3 class="mt-14 font-arcade text-[10px] tracking-widest text-cyan">MAKING NOTES</h3>
        <ul class="mt-6 space-y-5">
          {
            game.notes.map((note) => (
              <li class="flex gap-4">
                <PixelSprite sprite={bubble} width={16} class="mt-1.5 shrink-0" />
                <p class="text-base text-mist">{note}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <aside>
        <div class="pixel-window p-6">
          <h3 class="font-arcade text-[10px] tracking-widest text-cyan">BUILT WITH</h3>
          <ul class="mt-5 space-y-2.5">
            {
              game.tech.map((t) => (
                <li class="flex items-center gap-2.5 font-pixel text-base text-foam">
                  <span class="inline-block h-2 w-2 shrink-0 bg-sun" />
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-8 border-2 border-shallow p-6">
          <p class="text-base text-mist">
            こういうものを つくる仕事も 受けています。企画の段階からでもどうぞ。
          </p>
          <a href="/#services" class="mt-5 inline-block font-pixel text-base text-cyan hover:underline">
            → できることを見る
          </a>
        </div>
      </aside>
    </div>
  </section>

  {
    others.length > 0 && (
      <section class="border-t-2 border-shallow/60 bg-deep px-4 py-16 sm:px-6">
        <div class="mx-auto max-w-5xl">
          <h2 class="font-arcade text-[10px] tracking-widest text-dim">OTHER TITLES</h2>
          <ul class="mt-7 flex flex-wrap gap-4">
            {others.map((g) => (
              <li>
                <a
                  href={`/playground/${g.slug}`}
                  class="flex items-center gap-4 border-2 border-shallow px-5 py-4 transition-colors hover:border-cyan"
                >
                  <span
                    class="flex h-11 w-11 shrink-0 items-center justify-center font-arcade text-[9px]"
                    style={`background:${g.palette.bg}; color:${g.palette.fg};`}
                  >
                    {g.titleEn.slice(0, 2)}
                  </span>
                  <span>
                    <span class="block font-pixel text-lg text-foam">{g.title}</span>
                    <span class="block text-xs text-dim">{g.copy}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
