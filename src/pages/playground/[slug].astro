---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { games } from "../../data/games";

export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props;
const others = games.filter((candidate) => candidate.slug !== game.slug);
---

<Layout title={game.title} description={game.copy}>
  <section class="game-detail-hero" style={`--game-bg:${game.palette.bg}; --game-fg:${game.palette.fg}; --game-accent:${game.palette.accent};`}>
    <div class="game-detail-fluid" aria-hidden="true"></div>
    <div class="shell game-detail-inner">
      <a href="/playground" class="game-back">← あそびばへ</a>
      <p class="game-eyebrow">{game.year} / {game.status}</p>
      <h1>{game.titleEn}</h1>
      <p class="game-catch">{game.copy}</p>
      <a href={game.url} target="_blank" rel="noopener noreferrer" class="game-play-button">
        あそぶ <span aria-hidden="true">↗</span>
      </a>

      <div class="game-shot">
        <Image
          src={game.heroShot ?? game.shot}
          alt={`${game.title} のプレイ画面`}
          widths={[600, 1000, 1400]}
          sizes="(max-width: 1024px) 100vw, 1050px"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="game-detail-body">
    <div class="shell game-info-grid">
      <div>
        <p class="section-label">ABOUT THIS PROJECT</p>
        <h2>{game.title} について</h2>
        <p class="game-description">{game.description}</p>

        <h3>つくったときのメモ</h3>
        <ul class="note-list">
          {game.notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>

      <aside>
        <div class="tech-card">
          <p class="section-label">BUILT WITH</p>
          <ul>{game.tech.map((tech) => <li>{tech}</li>)}</ul>
        </div>
        <div class="project-callout">
          <p>こういうものをつくる仕事も受けています。企画の段階からでもどうぞ。</p>
          <a href="/#services" class="text-link">できることを見る <span aria-hidden="true">→</span></a>
        </div>
      </aside>
    </div>
  </section>

  {others.length > 0 && (
    <section class="other-games">
      <div class="shell">
        <p class="section-label">OTHER TITLES</p>
        <h2>ほかのあそび</h2>
        <div class="other-game-list">
          {others.map((other) => (
            <a href={`/playground/${other.slug}`}>
              <span class="other-game-mark" style={`background:${other.palette.bg}; color:${other.palette.fg};`}>{other.titleEn.slice(0, 2)}</span>
              <span><strong>{other.title}</strong><small>{other.copy}</small></span>
              <i aria-hidden="true">→</i>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
