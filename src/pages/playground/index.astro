---
import Layout from "../../layouts/Layout.astro";
import SeaBackdrop from "../../components/SeaBackdrop.astro";
import GameCard from "../../components/GameCard.astro";
import PixelSprite from "../../components/PixelSprite.astro";
import { minnow } from "../../data/sprites";
import { games } from "../../data/games";
---

<Layout
  title="あそびば"
  description="おさかなソフトがつくったブラウザゲームの置き場です。全部その場で遊べます。"
>
  <section class="relative overflow-hidden bg-abyss px-4 pt-36 pb-20 sm:px-6">
    <SeaBackdrop />
    <div class="relative mx-auto max-w-6xl">
      <p class="font-arcade text-[10px] tracking-widest text-sun">PLAYGROUND</p>
      <h1 class="mt-6 font-pixel text-[clamp(2.6rem,9vw,5.5rem)] leading-none text-foam text-shadow-pixel">
        あそびば
      </h1>
      <p class="mt-8 max-w-2xl text-lg font-bold text-foam sm:text-2xl">
        誰にも頼まれていないものを、いちばん本気でつくっています。
      </p>
      <p class="mt-5 max-w-xl text-base text-mist">
        ダウンロードも会員登録もいりません。開いたら遊べます。
      </p>
      <p class="mt-6 font-arcade text-[10px] text-dim">{games.length} TITLES AVAILABLE</p>
    </div>
  </section>

  <section class="bg-sea px-4 py-20 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-7 sm:grid-cols-2">
      {games.map((game) => <GameCard game={game} />)}
    </div>

    <div class="mx-auto mt-16 max-w-2xl border-2 border-dashed border-shallow p-10 text-center">
      <PixelSprite sprite={minnow} width={52} class="mx-auto animate-bob" />
      <p class="mt-5 font-pixel text-xl text-foam">つぎのやつ、つくってます</p>
      <p class="mt-3 text-base text-mist">
        しょうもないものから ちゃんとしたものまで。できたらここに並べます。
      </p>
    </div>
  </section>
</Layout>
