---
import Layout from "../layouts/Layout.astro";
import SeaBackdrop from "../components/SeaBackdrop.astro";
import PixelSprite from "../components/PixelSprite.astro";
import GameCard from "../components/GameCard.astro";
import { fish, minnow } from "../data/sprites";
import { site, services, steps, companyProfile } from "../data/site";
import { member, crew } from "../data/member";
import { games } from "../data/games";

const accentVar = {
  cyan: "var(--color-cyan)",
  coral: "var(--color-coral)",
  sun: "var(--color-sun)",
} as const;
---

<Layout>
  {/* ══ HERO ═══════════════════════════════════════ */}
  <section class="relative flex min-h-[100svh] items-center overflow-hidden bg-abyss pt-16">
    <SeaBackdrop />

    <div class="relative mx-auto w-full max-w-6xl px-4 py-20 sm:px-6">
      <p class="mb-6 flex items-center gap-3 font-arcade text-[10px] tracking-widest text-cyan">
        <span class="inline-block h-2 w-2 bg-cyan animate-blink"></span>
        ODAWARA, JAPAN / SOFTWARE STUDIO
      </p>

      <h1 class="font-pixel leading-[0.95] text-shadow-pixel">
        <span class="block text-[clamp(2.6rem,10vw,7rem)] text-foam">おさかなソフト</span>
        <span class="mt-4 block text-[clamp(1.1rem,3.6vw,2.1rem)] text-cyan">
          たのまれたものも、たのまれてないものも。
        </span>
      </h1>

      <p class="mt-8 max-w-2xl text-lg font-bold text-foam sm:text-xl">
        小田原のソフトウェア会社です。<br class="hidden sm:inline" />
        受託開発をやりながら、誰にも頼まれていないゲームをつくっています。
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a href={`mailto:${site.email}`} class="pixel-button bg-coral text-abyss">
          ▶ そうだんする
        </a>
        <a href="/playground" class="pixel-button border-sun bg-transparent text-sun">
          あそびばを見る ↓
        </a>
      </div>

      {/* ゲームのHUD風ステータスバー */}
      <div
        class="mt-16 grid max-w-3xl grid-cols-2 gap-px border-2 border-shallow bg-shallow sm:grid-cols-4"
      >
        {
          services.map((s) => (
            <a href={`#${s.id}`} class="group bg-deep px-4 py-3 transition-colors hover:bg-sea">
              <span class="block font-arcade text-[8px] text-dim">{s.no}</span>
              <span class="mt-1.5 block font-pixel text-sm text-mist group-hover:text-cyan">
                {s.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <a
      href="#about"
      class="absolute bottom-6 left-1/2 -translate-x-1/2 font-arcade text-[9px] text-dim hover:text-cyan"
    >
      <span class="animate-blink">▼ PRESS TO START</span>
    </a>
  </section>

  {/* ══ ABOUT ══════════════════════════════════════ */}
  <section id="about" class="relative border-t-2 border-shallow/60 bg-deep px-4 py-24 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-14 md:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="font-arcade text-[10px] tracking-widest text-cyan">00 / ABOUT</p>
        <h2 class="mt-5 font-pixel text-[clamp(2rem,6vw,3.4rem)] leading-tight text-foam">
          話した相手が、<br />
          <span class="text-cyan">そのままつくる。</span>
        </h2>
        <PixelSprite sprite={fish} width={100} class="mt-10 animate-bob" />
      </div>

      <div class="space-y-7">
        <p class="text-lg font-bold text-foam sm:text-xl">
          エンジニアがひとりで建てた法人です。営業も、間に入るディレクターもいません。
        </p>
        <p class="text-base text-mist sm:text-lg">
          そのぶん、伝言ゲームが起きません。相談した相手が、そのまま設計して、そのまま実装します。仕事は受託開発です。業務システム、アプリ、AIの導入。「こういうことできますか」の段階から入ります。
        </p>
        <p class="text-base text-mist sm:text-lg">
          それとは別に、誰にも頼まれていないものをつくっています。ゲームだったり、しょうもないミニアプリだったり。たぶんこれが会社の正体です。できたものは
          <a
            href="/playground"
            class="font-bold text-sun underline decoration-sun/50 underline-offset-4 hover:decoration-sun"
            >あそびば</a
          >
          に置いています。
        </p>

        <div class="flex flex-wrap gap-2 pt-1">
          {
            ["相談だけでもOK", "小さく始められる", "つくった人が答える", "運用まで見る"].map(
              (chip) => (
                <span class="border-2 border-shallow bg-sea/50 px-3 py-1.5 font-pixel text-sm text-foam">
                  {chip}
                </span>
              ),
            )
          }
        </div>
      </div>
    </div>
  </section>

  {/* ══ SERVICES ═══════════════════════════════════ */}
  <section id="services" class="border-t-2 border-shallow/60 bg-abyss px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="font-arcade text-[10px] tracking-widest text-cyan">01 / SERVICES</p>
          <h2 class="mt-5 font-pixel text-[clamp(2rem,6vw,3.4rem)] text-foam">できること</h2>
        </div>
        <p class="max-w-sm text-base font-bold text-foam">
          最初から大きく決めません。<br />
          いまの仕事に合うサイズから始めます。
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {
          services.map((s) => (
            <article id={s.id} class="pixel-window scroll-mt-24 p-7 sm:p-9">
              <div class="flex items-center gap-4">
                <span
                  class="font-arcade text-2xl"
                  style={`color:${accentVar[s.accent]}; text-shadow: 3px 3px 0 var(--color-abyss);`}
                >
                  {s.no}
                </span>
                <span class="font-arcade text-[9px] tracking-widest text-dim">{s.en}</span>
              </div>

              <h3 class="mt-5 font-pixel text-3xl text-foam">{s.title}</h3>

              <p
                class="mt-4 font-pixel text-lg leading-relaxed whitespace-pre-line"
                style={`color:${accentVar[s.accent]};`}
              >
                {s.lead}
              </p>

              <p class="mt-5 text-base text-mist">{s.body}</p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {s.tags.map((t) => (
                  <li class="border border-shallow px-2.5 py-1 font-arcade text-[9px] text-dim">
                    {t}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ══ PLAYGROUND ═════════════════════════════════ */}
  <section
    id="playground"
    class="relative overflow-hidden border-t-2 border-shallow/60 bg-sea px-4 py-24 sm:px-6"
  >
    <div class="relative mx-auto max-w-6xl">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="font-arcade text-[10px] tracking-widest text-sun">02 / PLAYGROUND</p>
          <h2 class="mt-5 font-pixel text-[clamp(2rem,6vw,3.4rem)] text-foam">あそびば</h2>
          <p class="mt-6 max-w-xl text-lg font-bold text-foam sm:text-xl">
            誰にも頼まれていないものを、いちばん本気でつくっています。
          </p>
        </div>
        <PixelSprite sprite={minnow} width={64} class="animate-bob" flip />
      </div>

      <div class="mt-14 grid gap-7 sm:grid-cols-2">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <div class="mt-12 text-center">
        <a href="/playground" class="pixel-button bg-sun text-abyss"> あそびば 一覧へ → </a>
      </div>
    </div>
  </section>

  {/* ══ HOW WE WORK ════════════════════════════════ */}
  <section class="border-t-2 border-shallow/60 bg-abyss px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <p class="font-arcade text-[10px] tracking-widest text-cyan">03 / HOW WE WORK</p>
      <h2 class="mt-5 font-pixel text-[clamp(2rem,6vw,3.4rem)] text-foam">すすめかた</h2>

      <ol class="mt-14 grid gap-6 md:grid-cols-3">
        {
          steps.map((step) => (
            <li class="relative border-2 border-shallow bg-deep p-7">
              <span class="font-arcade text-[9px] tracking-widest text-dim">{step.en}</span>
              <div class="mt-3 flex items-baseline gap-3">
                <span class="font-arcade text-3xl text-cyan text-shadow-pixel-sm">{step.no}</span>
                <h3 class="font-pixel text-2xl text-foam">{step.title}</h3>
              </div>
              <p class="mt-5 text-base text-mist">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ══ MEMBER ═════════════════════════════════════ */}
  <section id="member" class="border-t-2 border-shallow/60 bg-deep px-4 py-24 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <p class="font-arcade text-[10px] tracking-widest text-cyan">04 / MEMBER</p>
      <h2 class="mt-5 font-pixel text-[clamp(2rem,6vw,3.4rem)] text-foam">なかのひと</h2>

      <div class="mt-14 grid gap-10 md:grid-cols-[auto_1fr]">
        <div class="pixel-window flex h-44 w-44 shrink-0 items-center justify-center bg-sea">
          <PixelSprite sprite={fish} width={110} class="animate-bob" />
        </div>

        <div>
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
            <h3 class="font-pixel text-3xl text-foam">{member.name}</h3>
            <span class="font-arcade text-[10px] text-dim">{member.nameEn}</span>
          </div>
          <p class="mt-2 font-pixel text-lg text-cyan">{member.role}</p>

          <div class="mt-6 space-y-4 text-lg text-mist">
            {member.bio.map((line) => <p>{line}</p>)}
          </div>

          <ul class="mt-7 flex flex-wrap gap-2">
            {
              member.skills.map((s) => (
                <li class="border border-shallow bg-sea/40 px-2.5 py-1 font-arcade text-[9px] text-mist">
                  {s}
                </li>
              ))
            }
          </ul>

          <div class="mt-7 flex flex-wrap gap-3">
            {
              member.links.map((l) => (
                <a
                  href={l.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-2 border-shallow px-4 py-2 font-pixel text-sm text-foam transition-colors hover:border-cyan hover:text-cyan"
                >
                  {l.label} <span class="text-dim">{l.handle}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>

      {
        crew.show && (
          <div class="mt-14 border-l-4 border-coral bg-sea/30 p-7">
            <h3 class="font-pixel text-2xl text-coral">{crew.title}</h3>
            <p class="mt-4 max-w-2xl text-base text-mist">{crew.body}</p>
          </div>
        )
      }
    </div>
  </section>

  {/* ══ COMPANY ════════════════════════════════════ */}
  <section id="company" class="border-t-2 border-shallow/60 bg-abyss px-4 py-24 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[1fr_1.2fr]">
      <div>
        <p class="font-arcade text-[10px] tracking-widest text-cyan">05 / COMPANY</p>
        <h2 class="mt-5 font-pixel text-[clamp(2rem,6vw,3.4rem)] leading-tight text-foam">
          海と城のまち、<br />小田原から。
        </h2>
        <p class="mt-6 max-w-md text-base text-mist">
          小田原に構えていますが、打ち合わせはオンラインでも大丈夫です。全国どこの案件でも、まずは話を聞かせてください。
        </p>
      </div>

      <div class="pixel-window p-2">
        <dl class="divide-y divide-shallow/60">
          {
            companyProfile.map(([term, detail]) => (
              <div class="grid grid-cols-[7rem_1fr] gap-4 px-5 py-4 sm:grid-cols-[9rem_1fr]">
                <dt class="font-pixel text-sm text-dim">{term}</dt>
                <dd class="text-sm leading-relaxed text-foam">{detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ══ CONTACT ════════════════════════════════════ */}
  <section
    id="contact"
    class="relative overflow-hidden border-t-2 border-shallow/60 bg-deep px-4 py-28 sm:px-6"
  >
    <SeaBackdrop />
    <div class="relative mx-auto max-w-3xl text-center">
      <p class="font-arcade text-[10px] tracking-widest text-sun">06 / CONTACT</p>
      <h2 class="mt-6 font-pixel text-[clamp(2.2rem,7vw,4rem)] leading-tight text-foam text-shadow-pixel">
        はなしを、<br />きかせてください。
      </h2>
      <p class="mt-7 text-lg font-bold text-foam">
        「こんなことできる？」くらいで大丈夫です。<br />
        売り込みはしません。
      </p>

      <a
        href={`mailto:${site.email}`}
        class="pixel-button mx-auto mt-11 bg-coral text-abyss"
        style="font-size: 1.15rem; padding: 1.1rem 2rem;"
      >
        ✉ {site.email}
      </a>
    </div>
  </section>
</Layout>
