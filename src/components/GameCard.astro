---
import { Image } from "astro:assets";
import type { Game } from "../data/games";

interface Props {
  game: Game;
}

const { game } = Astro.props;
---

<article class="game-card">
  <a href={`/playground/${game.slug}`} class="game-image">
    <Image
      src={game.shot}
      alt={`${game.title} のスクリーンショット`}
      widths={[400, 800, 1200]}
      sizes="(max-width: 680px) 86vw, 560px"
      loading="lazy"
    />
    <span class="game-status">{game.status}</span>
  </a>

  <div class="game-meta">
    <span>{game.year}</span>
    <span>自主制作</span>
  </div>
  <h3><a href={`/playground/${game.slug}`}>{game.title}</a></h3>
  <p>{game.copy}</p>

  <div class="game-actions">
    <a href={game.url} target="_blank" rel="noopener noreferrer" class="pill-link pill-primary">
      あそぶ <span aria-hidden="true">↗</span>
    </a>
    <a href={`/playground/${game.slug}`} class="pill-link">くわしく</a>
  </div>
</article>
