---
import PixelSprite from "./PixelSprite.astro";
import { logoFish } from "../data/sprites";
import { site } from "../data/site";

const nav = [
  { href: "/#about", label: "このかいしゃ", en: "ABOUT" },
  { href: "/#services", label: "できること", en: "SERVICES" },
  { href: "/playground", label: "あそびば", en: "PLAYGROUND" },
  { href: "/#company", label: "かいしゃ情報", en: "COMPANY" },
];
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b-2 border-shallow/60 bg-abyss/85 backdrop-blur-sm"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4 sm:px-6">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${site.short} ホーム`}>
      <PixelSprite sprite={logoFish} width={34} />
      <span class="font-pixel text-lg leading-none tracking-wide text-foam">おさかなソフト</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="メインナビゲーション">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="group relative px-3 py-2 font-pixel text-sm text-mist transition-colors hover:text-cyan"
          >
            <span class="absolute -left-1 text-cyan opacity-0 transition-opacity group-hover:opacity-100">
              ▸
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={`mailto:${site.email}`}
      class="pixel-button ml-auto bg-coral text-abyss md:ml-2"
      style="font-size: 0.85rem; padding: 0.6rem 1rem;"
    >
      そうだんする
    </a>
  </div>
</header>
