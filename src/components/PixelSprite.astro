---
import type { Sprite } from "../data/sprites";

interface Props {
  sprite: Sprite;
  /** 表示幅（px）。高さはドット比から自動計算 */
  width?: number;
  class?: string;
  flip?: boolean;
  label?: string;
}

const { sprite, width = 64, class: className = "", flip = false, label } = Astro.props;

const cols = Math.max(...sprite.pattern.map((row) => row.length));
const rows = sprite.pattern.length;
const height = Math.round((width / cols) * rows);

// 同じ文字が横に連続する区間はひとつの rect にまとめる（DOMを減らすため）
type Run = { x: number; y: number; w: number; char: string };
const runs: Run[] = [];

sprite.pattern.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const char = row[x];
    if (char === "." || !sprite.colors[char]) {
      x += 1;
      continue;
    }
    let w = 1;
    while (x + w < row.length && row[x + w] === char) w += 1;
    runs.push({ x, y, w, char });
    x += w;
  }
});
---

<svg
  viewBox={`0 0 ${cols} ${rows}`}
  width={width}
  height={height}
  class:list={["pixelated", flip && "-scale-x-100", className]}
  role={label ? "img" : "presentation"}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {
    runs.map((run) => (
      <rect x={run.x} y={run.y} width={run.w} height={1} fill={sprite.colors[run.char]} />
    ))
  }
</svg>
