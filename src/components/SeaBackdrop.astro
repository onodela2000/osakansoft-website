---
import PixelSprite from "./PixelSprite.astro";
import { fish, minnow, bubble } from "../data/sprites";

// ビルド時に固定される「ランダム風」の配置。毎回変わると差分が読みにくいので決め打ち。
const swimmers = [
  { sprite: fish, top: "16%", width: 76, duration: 34, delay: -4, opacity: 0.5 },
  { sprite: minnow, top: "31%", width: 40, duration: 22, delay: -12, opacity: 0.35 },
  { sprite: minnow, top: "38%", width: 30, duration: 26, delay: -19, opacity: 0.28 },
  { sprite: fish, top: "62%", width: 52, duration: 41, delay: -27, opacity: 0.35 },
  { sprite: minnow, top: "74%", width: 46, duration: 29, delay: -8, opacity: 0.3 },
  { sprite: fish, top: "86%", width: 34, duration: 46, delay: -35, opacity: 0.22 },
];

const bubbles = [
  { left: "12%", size: 14, duration: 13, delay: -2 },
  { left: "27%", size: 9, duration: 17, delay: -9 },
  { left: "44%", size: 18, duration: 11, delay: -5 },
  { left: "58%", size: 10, duration: 19, delay: -14 },
  { left: "71%", size: 13, duration: 15, delay: -7 },
  { left: "88%", size: 8, duration: 21, delay: -11 },
];
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- 水そのもの。上（水面）ほど明るく、下へ落ちるほど暗い -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, #14315c 0%, #0e2145 22%, #0a1730 50%, #060b18 100%);"
  >
  </div>

  <!-- 水面から差し込む光 -->
  <div
    class="absolute inset-x-0 top-0 h-2/3 opacity-40"
    style="background: radial-gradient(ellipse 80% 100% at 50% -15%, var(--color-cyan) 0%, transparent 60%);"
  >
  </div>

  <!-- 光の柱。斜めに差し込む -->
  <div
    class="absolute inset-x-0 top-0 h-full opacity-[0.07]"
    style="background: repeating-linear-gradient(102deg, transparent 0px, transparent 60px, var(--color-cyan) 60px, var(--color-cyan) 96px, transparent 96px, transparent 190px);"
  >
  </div>

  {
    swimmers.map((s) => (
      <div
        class="absolute"
        style={`top:${s.top}; opacity:${s.opacity}; animation: swim ${s.duration}s linear ${s.delay}s infinite;`}
      >
        <PixelSprite sprite={s.sprite} width={s.width} />
      </div>
    ))
  }

  {
    bubbles.map((b) => (
      <div
        class="absolute bottom-0"
        style={`left:${b.left}; animation: rise ${b.duration}s linear ${b.delay}s infinite;`}
      >
        <PixelSprite sprite={bubble} width={b.size} />
      </div>
    ))
  }
</div>
